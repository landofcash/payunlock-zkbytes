# Run pnpm env:init to create .env with a random local database password.
POSTGRES_USER=payunlock
POSTGRES_DB=payunlock
POSTGRES_PASSWORD=REPLACE_LOCAL_PASSWORD
POSTGRES_PORT=5434
DATABASE_URL=postgresql://payunlock:REPLACE_LOCAL_PASSWORD@127.0.0.1:5434/payunlock
API_HOST=127.0.0.1
API_PORT=4321
API_ORIGINS=http://127.0.0.1:4320,http://localhost:4320
LOG_LEVEL=info
# Local Envio trial: pnpm indexer:setup generates the database/admin credentials.
# Set the HyperSync token locally; never expose these values via VITE_ variables.
ENVIO_API_TOKEN=
ENVIO_PG_PASSWORD=
ENVIO_HASURA_ADMIN_SECRET=
ENVIO_GRAPHQL_URL=http://127.0.0.1:8082/v1/graphql
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# For the Alchemy trial replace the URL above locally with:
# https://monad-testnet.g.alchemy.com/v2/YOUR_KEY
# Never put a private RPC key in VITE_ variables. Browser wallets use their own transport.
CHAIN_ID=10143
ALLOWED_CHAIN_IDS=10143
# MON payments are direct; Circle USDC is the initial sponsored payment token on Monad testnet.
ALLOWED_PAYMENT_ASSETS=0x0000000000000000000000000000000000000000,0x534b2f3A21130d7a60830c2Df862319e593943A3
# Switch only after the V5 deployment manifest, database reset, and indexer cutover are complete.
PAYUNLOCK_DEPLOYMENT_VERSION=v5
# Optional relayer worker. Use a separately funded key, never a browser/VITE_ variable.
RELAYER_PRIVATE_KEY=
RELAYER_DAILY_BUDGET_WEI=
RELAYER_MAX_GAS_LIMIT=2000000
RELAYER_MAX_FEE_PER_GAS_WEI=
ZKBYTES_SERVICE_URL=https://storage.example.invalid
ZKBYTES_DOWNLOAD_ORIGIN=https://download.example.invalid
ZKBYTES_MAX_RETENTION_SECONDS=31536000
ZKBYTES_PROFILE=zkbytes-wallet-eip191-hkdfsha256-ed25519-x25519-hpke-v1
# Browser wallets are enabled; WalletConnect additionally requires a public Reown project ID.
VITE_API_ORIGIN=http://127.0.0.1:4321
VITE_CHAIN_ID=10143
VITE_WALLETS_ENABLED=true
VITE_REOWN_PROJECT_ID=
# Configure deployment keys with Hardhat keystore, never VITE_ variables.
# MONAD_TESTNET_DEPLOYER_KEY=
# MONAD_MAINNET_RPC_URL=
# MONAD_MAINNET_DEPLOYER_KEY=

# Optional storage adapters; local origins only, never credentials.
STORAGE_SERVICES_JSON=
ZKBYTES_OFFER_NEW=true
